---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnimatedHero from '../components/AnimatedHero';
import AnimatedSkillBar from '../components/AnimatedSkillBar';
import FadeIn from '../components/FadeIn';
import ProunCanvas from '../components/ProunCanvas';
import SectionAccent from '../components/SectionAccent';

interface ZennArticle {
  id: number;
  title: string;
  slug: string;
  emoji: string;
  article_type: 'tech' | 'idea';
  published_at: string;
  liked_count: number;
}

// ビルド時に Zenn API から記事を取得
let zennArticles: ZennArticle[] = [];
try {
  const res = await fetch('https://zenn.dev/api/articles?username=hironobunigo&order=latest&count=6');
  if (res.ok) {
    const data = await res.json();
    zennArticles = data.articles ?? [];
  }
} catch {
  // 取得失敗時はフォールバック表示
}

// ビルド時に GitHub API から公開リポジトリ一覧を取得（言語分布と Portfolio の両方で使用）
interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  pushed_at: string;
  fork: boolean;
  archived: boolean;
}

// Portfolio に載せないリポジトリ（業務関連）。CLAUDE.md「規約」参照
const excludedRepos = /faj|do.?hug/i;

let githubRepos: GitHubRepo[] = [];
try {
  const reposRes = await fetch(
    'https://api.github.com/users/nigoh/repos?per_page=100&type=owner',
    { headers: { Accept: 'application/vnd.github+json' } }
  );
  if (reposRes.ok) {
    githubRepos = await reposRes.json();
  }
} catch {
  // 取得失敗時は言語分布・Portfolio ともフォールバック表示
}

interface GitHubLang {
  name: string;
  percent: number;
  color: string;
}

const langColors: Record<string, string> = {
  TypeScript: '#3178C6',
  JavaScript: '#F1E05A',
  Python: '#3572A5',
  Java: '#B07219',
  Kotlin: '#A97BFF',
  'C++': '#F34B7D',
  C: '#555555',
  Rust: '#DEA584',
  Astro: '#FF5A03',
  HTML: '#E34C26',
  CSS: '#563D7C',
  Shell: '#89E051',
};

const langCounts: Record<string, number> = {};
for (const r of githubRepos) {
  if (r.language) langCounts[r.language] = (langCounts[r.language] ?? 0) + 1;
}
const langTotal = Object.values(langCounts).reduce((a, b) => a + b, 0);
const topLangs: GitHubLang[] = Object.entries(langCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([name, count]) => ({
    name,
    percent: Math.round((count / langTotal) * 100),
    color: langColors[name] ?? '#64748b',
  }));

// T7 マーキーの語 — 既存キーワードの反復のみ（新情報を載せない — trends-2026-refresh.spec §8）
const marqueeWords = [
  'C/C++',
  'JAVA',
  'TYPESCRIPT',
  'PYTHON',
  'AI-DRIVEN DEV',
  'SPEC-DRIVEN DEV',
  'SAPPORO, JAPAN',
];

// 4 カテゴリ・各 2〜4 項目に集約（index.spec.md §3）
const skills = [
  {
    category: 'LANGUAGES',
    items: [
      { name: 'C / C++', level: 90, description: 'システムプログラミング・組み込み開発（8年以上）' },
      { name: 'Java', level: 70, description: '組み込み Android アプリ（実務・2026〜）／オブジェクト指向設計' },
      { name: 'TypeScript / JavaScript', level: 70, description: '個人開発中心 — Web アプリ・型安全な実装' },
      { name: 'Python', level: 65, description: 'スクリプティング・データ処理・自動化（約2年）' },
    ],
  },
  {
    category: 'PLATFORMS',
    items: [
      { name: 'Windows / MFC', level: 80, description: 'デスクトップアプリ・組み込みシステム開発（8年以上）' },
      { name: 'Linux (Ubuntu / Yocto)', level: 65, description: 'サーバー・組み込み Linux（約2年）' },
      { name: 'Android SDK', level: 55, description: '専用端末向けネイティブアプリの Java 開発（実務・2026〜）' },
      { name: 'React / Astro', level: 65, description: '個人開発中心 — UI 構築・静的サイト' },
    ],
  },
  {
    category: 'DEV & INFRA',
    items: [
      { name: 'Git / GitLab', level: 85, description: 'バージョン管理・CI/CD・チーム開発フロー整備（約6年）' },
      { name: 'Docker', level: 75, description: 'コンテナ化・開発環境標準化（約4年）' },
      { name: 'RDB (PostgreSQL / Oracle)', level: 70, description: 'DB 設計・クエリ最適化（約3年）' },
    ],
  },
  {
    category: 'AI-DRIVEN DEV',
    items: [
      { name: 'AI コーディングエージェント', level: 85, description: 'Claude Code / GitHub Copilot / Codex — サブエージェント・フック・SWE Agent による自律開発' },
      { name: 'MCP / エージェント設計', level: 80, description: 'MCP サーバーと AGENTS.md / CLAUDE.md / .kiro でエージェントの能力・挙動を拡張' },
    ],
  },
];

const career = [
  {
    year: '2026',
    period: '2026/04〜現在',
    industry: '組み込み Android（専用端末向けアプリ）',
    phase: '詳細設計・実装・試験',
    techs: ['Java', 'Android SDK', 'Android Studio', 'Gradle', 'Git'],
  },
  {
    year: '2025',
    period: '2025（約1年）',
    industry: '組み込み制御（社会インフラ機器・コアシステム）',
    phase: '詳細設計・実装・試験',
    techs: ['C', 'Linux (Yocto)', 'Make'],
  },
  {
    year: '2022',
    period: '2022、2025（約3年）',
    industry: '組み込み制御（社会インフラ機器・制御システム）',
    phase: '要件定義〜マネジメント（サブリーダー）',
    techs: ['C++', 'MFC', 'Git', 'Docker'],
  },
  {
    year: '2021',
    period: '2021～2022（約1年）',
    industry: '車載地図データツール',
    phase: '設計・実装・マネジメント',
    techs: ['C++', 'Oracle', 'VS Code'],
  },
  {
    year: '2020',
    period: '2020～2021（約1年）',
    industry: '車載地図データ変換ツール',
    phase: '設計〜インフラ構築',
    techs: ['Java', 'C++', 'PostgreSQL', 'AWS'],
  },
  {
    year: '2018',
    period: '2018～2020（約2年）',
    industry: '車載地図データツール（サブリーダー）',
    phase: '設計・実装・マネジメント',
    techs: ['C++', 'Python', 'PostgreSQL'],
  },
  {
    year: '2016',
    period: '2016～2018（約1年半）',
    industry: '自動運転用3D地図・試作モジュール開発',
    phase: '詳細設計・実装・試験',
    techs: ['C++11', 'Java', 'Python', 'MongoDB'],
  },
];

// Portfolio — GitHub の公開リポジトリからビルド時に自動生成（fork・アーカイブ・除外パターンを除く）。
// 直近 90 日以内に push があるものは「製作中」バッジを表示する。
interface ProjectCard {
  name: string;
  description: string;
  url: string;
  tags: string[];
  wip: boolean;
}

const WIP_WINDOW_MS = 90 * 24 * 60 * 60 * 1000;
const buildTime = Date.now();

const githubProjects: ProjectCard[] = githubRepos
  .filter((r) => !r.fork && !r.archived && !excludedRepos.test(r.name))
  .sort((a, b) => new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime())
  .slice(0, 8)
  .map((r) => ({
    name: r.name.replace(/[-_]+/g, ' ').trim().toUpperCase(),
    description: r.description ?? '自己開発プロジェクト。詳細は GitHub リポジトリを参照。',
    url: r.html_url,
    tags: r.language ? [r.language] : [],
    wip: buildTime - new Date(r.pushed_at).getTime() < WIP_WINDOW_MS,
  }));

// API 取得失敗時のフォールバック（代表的な公開リポジトリのみ）
const fallbackProjects: ProjectCard[] = [
  {
    name: 'NIGOH',
    description: 'このサイトのソースコード。Astro + Tailwind CSS で構築した個人紹介サイト。',
    url: 'https://github.com/nigoh/nigoh',
    tags: ['Astro', 'TypeScript'],
    wip: true,
  },
  {
    name: 'JUML',
    description: '開発中の自己開発プロジェクト。詳細は GitHub リポジトリを参照。',
    url: 'https://github.com/nigoh/Juml',
    tags: [],
    wip: true,
  },
  {
    name: 'QR GENERATOR WEB',
    description: 'QRコード生成Webアプリ。Copilot + Serena による AI ペアプログラミングで開発。',
    url: 'https://github.com/nigoh/qr-generator-web',
    tags: ['TypeScript', 'React'],
    wip: false,
  },
  {
    name: 'STOCKO',
    description: '株価情報取得ツール。OpenAI Codex & AGENTS.md を活用した AI エージェント開発。',
    url: 'https://github.com/nigoh/stocko',
    tags: ['JavaScript', 'AI: Codex + AGENTS.md'],
    wip: false,
  },
];

const projects = githubProjects.length > 0 ? githubProjects : fallbackProjects;

// AI 駆動開発のツール・実践（各 icon は Heroicons outline の path）
interface AiTool {
  title: string;
  body: string;
  icon: string[];
}

const aiTools: AiTool[] = [
  {
    title: 'CLAUDE CODE',
    body: 'designer / frontend のサブエージェントと PreToolUse フックを組み合わせ、役割分担と安全策を備えた自律開発を実践。このサイト自体も Claude Code で構築・改善。',
    icon: ['M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z'],
  },
  {
    title: 'COPILOT SWE AGENT',
    body: 'Issue からの自動実装・PR 作成。Focuso や QR Generator Web で SWE Agent をコントリビューターとして活用。',
    icon: ['M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z'],
  },
  {
    title: 'OPENAI CODEX',
    body: 'AGENTS.md を活用した AI エージェント駆動開発。stocko プロジェクトで Codex によるコード生成を実践。',
    icon: ['M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5'],
  },
  {
    title: 'MCP',
    body: 'GitHub, Playwright, Tailwind CSS 等の MCP サーバーを活用し、AI エージェントの能力を拡張。',
    icon: ['M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244'],
  },
  {
    title: 'AGENT CONFIG',
    body: '.instructions.md, AGENTS.md, CLAUDE.md, .kiro 等の設定でプロジェクトごとに AI エージェントの振る舞いをカスタマイズ。',
    icon: [
      'M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z',
      'M15 12a3 3 0 11-6 0 3 3 0 016 0z',
    ],
  },
  {
    title: 'SPEC-DRIVEN DEV',
    body: 'specs/** の仕様を AI と更新しながら実装し、受入条件（チェックリスト）で検証する仕様駆動開発（SDD）を実践。',
    icon: ['M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z'],
  },
