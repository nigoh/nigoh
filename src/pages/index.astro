---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StagePane from '../components/StagePane.astro';
import StageRail from '../components/StageRail.astro';
import { stages } from '../components/stageList';
import SandLogo from '../components/SandLogo.astro';
import SandMeters from '../components/SandMeters.astro';
import CableBoard from '../components/CableBoard.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import ToolBox from '../components/ToolBox.astro';
import type { BoardJob } from '../components/board';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';

interface ZennArticle {
  id: number;
  title: string;
  slug: string;
  emoji: string;
  article_type: 'tech' | 'idea';
  published_at: string;
  liked_count: number;
}

// ビルド時に Zenn API から記事を取得
let zennArticles: ZennArticle[] = [];
try {
  const res = await fetch('https://zenn.dev/api/articles?username=hironobunigo&order=latest&count=6');
  if (res.ok) {
    const data = await res.json();
    zennArticles = data.articles ?? [];
  }
} catch {
  // 取得失敗時はフォールバック表示
}

// ビルド時に GitHub API から公開リポジトリ一覧を取得（言語分布と Portfolio の両方で使用）
interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  pushed_at: string;
  fork: boolean;
  archived: boolean;
}

// Portfolio に載せないリポジトリ（業務関連）。CLAUDE.md「規約」参照
const excludedRepos = /faj|do.?hug/i;

let githubRepos: GitHubRepo[] = [];
try {
  const reposRes = await fetch(
    'https://api.github.com/users/nigoh/repos?per_page=100&type=owner',
    { headers: { Accept: 'application/vnd.github+json' } }
  );
  if (reposRes.ok) {
    githubRepos = await reposRes.json();
  }
} catch {
  // 取得失敗時は言語分布・Portfolio ともフォールバック表示
}

interface GitHubLang {
  name: string;
  percent: number;
  color: string;
}

const langColors: Record<string, string> = {
  TypeScript: '#3178C6',
  JavaScript: '#F1E05A',
  Python: '#3572A5',
  Java: '#B07219',
  Kotlin: '#A97BFF',
  'C++': '#F34B7D',
  C: '#555555',
  Rust: '#DEA584',
  Astro: '#FF5A03',
  HTML: '#E34C26',
  CSS: '#563D7C',
  Shell: '#89E051',
};

const langCounts: Record<string, number> = {};
for (const r of githubRepos) {
  if (r.language) langCounts[r.language] = (langCounts[r.language] ?? 0) + 1;
}
const langTotal = Object.values(langCounts).reduce((a, b) => a + b, 0);
const topLangs: GitHubLang[] = Object.entries(langCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([name, count]) => ({
    name,
    percent: Math.round((count / langTotal) * 100),
    color: langColors[name] ?? '#64748b',
  }));

// 4 分野・各 2〜4 項目（index.spec.md §3）。見出しは日本語、英語は小さな札（plug-2026.spec「文字」）
const skills = [
  {
    label: '言語',
    en: 'languages',
    items: [
      { name: 'C / C++', short: 'C/C++', level: 90, description: 'システムプログラミング・組み込み開発（8年以上）' },
      { name: 'Java', short: 'Java', level: 70, description: '組み込み Android アプリ（実務・2026〜）／オブジェクト指向設計' },
      { name: 'TypeScript / JavaScript', short: 'TS/JS', level: 70, description: '個人開発中心 — Web アプリ・型安全な実装' },
      { name: 'Python', short: 'Python', level: 65, description: 'スクリプティング・データ処理・自動化（約2年）' },
    ],
  },
  {
    label: 'プラットフォーム',
    en: 'platforms',
    items: [
      { name: 'Windows / MFC', short: 'MFC', level: 80, description: 'デスクトップアプリ・組み込みシステム開発（8年以上）' },
      { name: 'Linux (Ubuntu / Yocto)', short: 'Linux', level: 65, description: 'サーバー・組み込み Linux（約2年）' },
      { name: 'Android SDK', short: 'Android', level: 55, description: '専用端末向けネイティブアプリの Java 開発（実務・2026〜）' },
      { name: 'React / Astro', short: 'React', level: 65, description: '個人開発中心 — UI 構築・静的サイト' },
    ],
  },
  {
    label: '開発と基盤',
    en: 'dev & infra',
    items: [
      { name: 'Git / GitLab', short: 'Git', level: 85, description: 'バージョン管理・CI/CD・チーム開発フロー整備（約6年）' },
      { name: 'Docker', short: 'Docker', level: 75, description: 'コンテナ化・開発環境標準化（約4年）' },
      { name: 'RDB (PostgreSQL / Oracle)', short: 'RDB', level: 70, description: 'DB 設計・クエリ最適化（約3年）' },
    ],
  },
  {
    label: 'AI 駆動開発',
    en: 'ai-driven dev',
    items: [
      { name: 'AI コーディングエージェント', short: 'AI エージェント', level: 85, description: 'Claude Code / GitHub Copilot / Codex — サブエージェント・フック・SWE Agent による自律開発' },
      { name: 'MCP / エージェント設計', short: 'MCP', level: 80, description: 'MCP サーバーと AGENTS.md / CLAUDE.md / .kiro でエージェントの能力・挙動を拡張' },
    ],
  },
];

// 経歴。span は仕事の札の中の小さな帯に使う、おおよその年（end: null は進行中）。
interface CareerItem {
  period: string;
  industry: string;
  phase: string;
  techs: string[];
  span: { label: string; when: string; start: number; end: number | null };
}

const career: CareerItem[] = [
  {
    period: '2026/04〜現在',
    industry: '組み込み Android（専用端末向けアプリ）',
    phase: '詳細設計・実装・試験',
    techs: ['Java', 'Android SDK', 'Android Studio', 'Gradle', 'Git'],
    span: { label: '組み込み Android', when: '2026–', start: 2026.25, end: null },
  },
  {
    period: '2025（約1年）',
    industry: '組み込み制御（社会インフラ機器・コアシステム）',
    phase: '詳細設計・実装・試験',
    techs: ['C', 'Linux (Yocto)', 'Make'],
    span: { label: '社会インフラ機器・コア', when: '2025', start: 2025, end: 2026 },
  },
  {
    period: '2022、2025（約3年）',
    industry: '組み込み制御（社会インフラ機器・制御システム）',
    phase: '要件定義〜マネジメント（サブリーダー）',
    techs: ['C++', 'MFC', 'Git', 'Docker'],
    span: { label: '社会インフラ機器・制御', when: '2022–25', start: 2022, end: 2025 },
  },
  {
    period: '2021～2022（約1年）',
    industry: '車載地図データツール',
    phase: '設計・実装・マネジメント',
    techs: ['C++', 'Oracle', 'VS Code'],
    span: { label: '車載地図データツール', when: '2021–22', start: 2021, end: 2022 },
  },
  {
    period: '2020～2021（約1年）',
    industry: '車載地図データ変換ツール',
    phase: '設計〜インフラ構築',
    techs: ['Java', 'C++', 'PostgreSQL', 'AWS'],
    span: { label: '車載地図データ変換', when: '2020–21', start: 2020, end: 2021 },
  },
  {
    period: '2018～2020（約2年）',
    industry: '車載地図データツール（サブリーダー）',
    phase: '設計・実装・マネジメント',
    techs: ['C++', 'Python', 'PostgreSQL'],
    span: { label: '車載地図データツール', when: '2018–20', start: 2018, end: 2020 },
  },
  {
    period: '2016～2018（約1年半）',
    industry: '自動運転用3D地図・試作モジュール開発',
    phase: '詳細設計・実装・試験',
    techs: ['C++11', 'Java', 'Python', 'MongoDB'],
    span: { label: '自動運転用 3D 地図・試作', when: '2016–18', start: 2016.5, end: 2018 },
  },
];

// 小さな帯の目盛り（2016〜2028。真ん中がちょうど 2022 になる幅）と、ビルドした日（進行中の帯の終わり）
const ganttFrom = 2016;
const ganttTo = 2028;
const buildDate = new Date();
const nowYear = Math.min(ganttTo, buildDate.getFullYear() + buildDate.getMonth() / 12);
const pct = (year: number): number => Math.round(((year - ganttFrom) / (ganttTo - ganttFrom)) * 1000) / 10;

// 経歴のケーブルボード（C）：プラグを差した仕事をモニターに出す。札の中の帯で、いつの仕事かを見せる
const boardJobs: BoardJob[] = career.map((c) => {
  const end = c.span.end ?? nowYear;
  return {
    period: c.period,
    short: c.span.label,
    industry: c.industry,
    phase: c.phase,
    techs: c.techs,
    ongoing: c.span.end === null,
    when: c.span.when,
    bar: { left: pct(c.span.start), width: Math.max(2, Math.round((pct(end) - pct(c.span.start)) * 10) / 10) },
  };
});

// Portfolio — GitHub の公開リポジトリからビルド時に自動生成（fork・アーカイブ・除外パターンを除く）。
// 直近 90 日以内に push があるものは「進行中」、それより前は「一区切り」（作品の切り替え）。
interface ProjectCard {
  name: string;
  description: string;
  url: string;
  tags: string[];
  wip: boolean;
}

const WIP_WINDOW_MS = 90 * 24 * 60 * 60 * 1000;
const buildTime = buildDate.getTime();

const githubProjects: ProjectCard[] = githubRepos
  .filter((r) => !r.fork && !r.archived && !excludedRepos.test(r.name))
  .sort((a, b) => new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime())
  .slice(0, 8)
  .map((r) => ({
    name: r.name,
    description: r.description ?? '自己開発プロジェクト。詳細は GitHub リポジトリを参照。',
    url: r.html_url,
    tags: r.language ? [r.language] : [],
    wip: buildTime - new Date(r.pushed_at).getTime() < WIP_WINDOW_MS,
  }));

// API 取得失敗時のフォールバック（代表的な公開リポジトリのみ）
const fallbackProjects: ProjectCard[] = [
  {
    name: 'nigoh',
    description: 'このサイトのソースコード。Astro + Tailwind CSS で構築した個人紹介サイト。',
    url: 'https://github.com/nigoh/nigoh',
    tags: ['Astro', 'TypeScript'],
    wip: true,
  },
  {
    name: 'Juml',
    description: '開発中の自己開発プロジェクト。詳細は GitHub リポジトリを参照。',
    url: 'https://github.com/nigoh/Juml',
    tags: [],
    wip: true,
  },
  {
    name: 'qr-generator-web',
    description: 'QRコード生成Webアプリ。Copilot + Serena による AI ペアプログラミングで開発。',
    url: 'https://github.com/nigoh/qr-generator-web',
    tags: ['TypeScript', 'React'],
    wip: false,
  },
  {
    name: 'stocko',
    description: '株価情報取得ツール。OpenAI Codex & AGENTS.md を活用した AI エージェント開発。',
    url: 'https://github.com/nigoh/stocko',
    tags: ['JavaScript', 'AI: Codex + AGENTS.md'],
    wip: false,
  },
];

const projects = githubProjects.length > 0 ? githubProjects : fallbackProjects;
const boardColumns: { key: string; label: string; icon: IconName; tone: string; items: ProjectCard[] }[] = [
  { key: 'wip', label: '進行中', icon: 'circle-play', tone: 'text-ui-teal', items: projects.filter((p) => p.wip) },
  { key: 'done', label: '一区切り', icon: 'circle-check', tone: 'text-ui-ok', items: projects.filter((p) => !p.wip) },
];

// AI 駆動開発のツール・やり方（アイコンは Lucide）
interface AiTool {
  title: string;
  /** 札に出す 1 行（開くと body の全文） */
  summary: string;
  body: string;
  icon: IconName;
}

const aiTools: AiTool[] = [
  {
    title: 'Claude Code',
    summary: 'サブエージェントとフックで、役割分担と安全策を備えた自律開発。',
    body: 'designer / frontend のサブエージェントと PreToolUse フックを組み合わせ、役割分担と安全策を備えた自律開発を実践。このサイト自体も Claude Code で構築・改善。',
    icon: 'terminal',
  },
  {
    title: 'Copilot SWE Agent',
    summary: 'Issue からの自動実装・PR 作成。',
    body: 'Issue からの自動実装・PR 作成。Focuso や QR Generator Web で SWE Agent をコントリビューターとして活用。',
    icon: 'sparkles',
  },
  {
    title: 'OpenAI Codex',
    summary: 'AGENTS.md を活用したエージェント駆動開発。',
    body: 'AGENTS.md を活用した AI エージェント駆動開発。stocko プロジェクトで Codex によるコード生成を実践。',
    icon: 'code-xml',
  },
  {
    title: 'MCP',
    summary: 'MCP サーバーで AI エージェントの能力を拡張。',
    body: 'GitHub, Playwright, Tailwind CSS 等の MCP サーバーを活用し、AI エージェントの能力を拡張。',
    icon: 'plug',
  },
  {
    title: 'エージェントの設定',
    summary: '設定ファイルで、プロジェクトごとに振る舞いを変える。',
    body: '.instructions.md, AGENTS.md, CLAUDE.md, .kiro 等の設定でプロジェクトごとに AI エージェントの振る舞いをカスタマイズ。',
    icon: 'sliders-horizontal',
  },
  {
    title: '仕様駆動開発',
    summary: '仕様を AI と更新しながら実装し、受入条件で検証。',
    body: 'specs/** の仕様を AI と更新しながら実装し、受入条件（チェックリスト）で検証する仕様駆動開発（SDD）を実践。',
    icon: 'clipboard-check',
  },
];

const interests = [
  { title: 'RAG / AI 意思決定支援', body: '生成 AI を用いた RAG（検索拡張生成）による意思決定支援アプリの開発に強い関心を持ち、個人開発で実践中。' },
  { title: '開発フロー整備', body: 'Docker による環境標準化・Git/GitLab を活用したチーム開発フロー設計・CI/CD パイプライン構築。' },
  { title: '技術普及・後進育成', body: 'チームへの技術指導・コードレビュー文化の醸成。AI ツールを活用した生産性向上の横展開。' },
];

const profile = [
  { k: '名前', v: 'Hironobu Nigo' },
  { k: '生まれ', v: '1984', mono: true },
  { k: '拠点', v: '札幌市, 北海道, Japan' },
  { k: '役割', v: 'Software Engineer' },
];

const heroKeywords = ['C/C++', 'Java', 'TypeScript', 'Python'];

// GitHub のマーク（塗りの形。Lucide ではない）
const githubMark =
  'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z';

// 流れの段のひとこと（件数など）
const stageFacts: Record<string, string> = {
  hero: 'start',
  about: '札幌',
  skills: `${skills.reduce((n, g) => n + g.items.length, 0)} 項目`,
  ai: `${aiTools.length} つ`,
  career: `${career.length} 件`,
  portfolio: `${projects.length} 件`,
  contact: 'end',
