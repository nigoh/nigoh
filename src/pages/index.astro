---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnimatedHero from '../components/AnimatedHero';
import AnimatedSkillBar from '../components/AnimatedSkillBar';
import AnimatedTimeline from '../components/AnimatedTimeline';
import FadeIn from '../components/FadeIn';

interface ZennArticle {
  id: number;
  title: string;
  slug: string;
  emoji: string;
  article_type: 'tech' | 'idea';
  published_at: string;
  liked_count: number;
}

// ビルド時に Zenn API から記事を取得
let zennArticles: ZennArticle[] = [];
try {
  const res = await fetch('https://zenn.dev/api/articles?username=hironobunigo&order=latest&count=6');
  if (res.ok) {
    const data = await res.json();
    zennArticles = data.articles ?? [];
  }
} catch {
  // 取得失敗時はフォールバック表示
}

// ビルド時に GitHub API からリポジトリ言語分布を取得
interface GitHubLang {
  name: string;
  percent: number;
  color: string;
}

const langColors: Record<string, string> = {
  TypeScript: '#3178C6',
  JavaScript: '#F1E05A',
  Python: '#3572A5',
  'C++': '#F34B7D',
  C: '#555555',
  Rust: '#DEA584',
  Astro: '#FF5A03',
  HTML: '#E34C26',
  CSS: '#563D7C',
  Shell: '#89E051',
};

let topLangs: GitHubLang[] = [];
try {
  const reposRes = await fetch(
    'https://api.github.com/users/nigoh/repos?per_page=100&type=owner',
    { headers: { Accept: 'application/vnd.github+json' } }
  );
  if (reposRes.ok) {
    const repos: Array<{ language: string | null }> = await reposRes.json();
    const counts: Record<string, number> = {};
    for (const r of repos) {
      if (r.language) counts[r.language] = (counts[r.language] ?? 0) + 1;
    }
    const total = Object.values(counts).reduce((a, b) => a + b, 0);
    topLangs = Object.entries(counts)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 6)
      .map(([name, count]) => ({
        name,
        percent: Math.round((count / total) * 100),
        color: langColors[name] ?? '#64748b',
      }));
  }
} catch {
  // フォールバック: 空のまま
}

const skills = [
  {
    category: 'LANGUAGES',
    items: [
      { name: 'C / C++', level: 90, description: 'システムプログラミング・組み込み開発' },
      { name: 'TypeScript', level: 85, description: 'Webアプリケーション・型安全な開発' },
      { name: 'Python', level: 80, description: 'スクリプティング・データ処理・自動化' },
      { name: 'JavaScript', level: 75, description: 'フロントエンド・プロトタイピング' },
    ],
  },
  {
    category: 'TOOLS & INFRASTRUCTURE',
    items: [
      { name: 'Git', level: 90, description: 'バージョン管理・チーム開発' },
      { name: 'Linux', level: 85, description: 'サーバー構築・シェルスクリプト' },
      { name: 'Docker', level: 80, description: 'コンテナ化・開発環境構築' },
    ],
  },
  {
    category: 'AI TOOLS',
    items: [
      { name: 'GitHub Copilot', level: 90, description: 'AI ペアプログラミング・SWE Agent 活用' },
      { name: 'MCP', level: 80, description: 'Model Context Protocol によるツール連携' },
      { name: 'AI Agent 構築', level: 75, description: 'AGENTS.md / .kiro / Serena 設定' },
    ],
  },
];

const timeline = [
  { year: '1984', title: 'BORN', description: '北海道に生まれる' },
  { year: '2000s', title: 'PROGRAMMING', description: 'プログラミングを始める。C/C++ を中心に学ぶ' },
  { year: '2010s', title: 'CAREER', description: 'ソフトウェアエンジニアとしてキャリアを積む' },
  { year: '2020s', title: 'NOW', description: 'TypeScript, Python にも領域を広げ、AI ツールを活用した開発に従事' },
];

const projects = [
  {
    name: 'FOCUSO',
    description: 'フォーカスタイマーアプリ。React + Zustand で構築。Copilot SWE Agent & .kiro で AI 駆動開発。',
    url: 'https://github.com/nigoh/Timer',
    tags: ['TypeScript', 'React', 'Zustand', 'AI: Copilot SWE Agent'],
  },
  {
    name: 'QR GENERATOR WEB',
    description: 'QRコード生成Webアプリ。Copilot + Serena による AI ペアプログラミングで開発。',
    url: 'https://github.com/nigoh/qr-generator-web',
    tags: ['TypeScript', 'React', 'Vite', 'AI: Copilot + Serena'],
  },
  {
    name: 'STOCKO',
    description: '株価情報取得ツール。OpenAI Codex & AGENTS.md を活用した AI エージェント開発。',
    url: 'https://github.com/nigoh/stocko',
    tags: ['JavaScript', 'HTML/CSS', 'AI: Codex + AGENTS.md'],
  },
  {
    name: 'NIGOH',
    description: 'このサイトのソースコード。Astro + Tailwind CSS で構築した個人紹介サイト。',
    url: 'https://github.com/nigoh/nigoh',
    tags: ['Astro', 'Tailwind CSS', 'TypeScript'],
  },
];
---

<BaseLayout title="H.NIGO | Software Engineer">
  <Header />

  <main class="pt-14">

    {/* ═══════════════════ Hero — 構成主義的ヒーロー ═══════════════════ */}
    <section class="relative overflow-hidden bg-constructivist-black min-h-[90vh] flex items-center">
      {/* 幾何学的背景装飾 */}
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        {/* 大きな赤い正方形 — 斜め配置 */}
        <div class="absolute -top-20 -right-20 w-80 h-80 bg-constructivist-red transform rotate-12 opacity-90"></div>
        {/* 小さな正方形 */}
        <div class="absolute bottom-20 left-10 w-16 h-16 bg-constructivist-red transform -rotate-6"></div>
        {/* 円 */}
        <div class="absolute top-1/3 right-1/4 w-40 h-40 rounded-full border-4 border-constructivist-cream opacity-20"></div>
        {/* 斜線 */}
        <div class="absolute top-0 left-1/3 w-1 h-full bg-constructivist-cream opacity-10 transform rotate-12 origin-top"></div>
        <div class="absolute bottom-0 right-1/3 w-1 h-2/3 bg-constructivist-red opacity-30 transform -rotate-6 origin-bottom"></div>
        {/* 小さな黒い正方形（ライトモード対比） */}
        <div class="absolute bottom-40 right-20 w-8 h-8 bg-constructivist-cream opacity-15 transform rotate-45"></div>
      </div>

      <AnimatedHero
        client:load
        name="H.NIGO"
        role="SOFTWARE ENGINEER"
        description="低レイヤーからアプリケーションまで。C/C++, TypeScript, Python を使い、AI ツールを活用してものづくりをしています。"
        githubUrl="https://github.com/nigoh"
        avatarUrl="https://github.com/nigoh.png"
      />
    </section>

    {/* ═══════════════════ About ═══════════════════ */}
    <section id="about" class="relative py-20 overflow-hidden">
      {/* 装飾 — 赤い縦バー */}
      <div class="absolute top-0 left-0 w-2 h-full bg-constructivist-red" aria-hidden="true"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <FadeIn client:visible direction="left">
          <h2 class="font-sans text-5xl sm:text-6xl text-constructivist-black tracking-tight mb-12">ABOUT</h2>
        </FadeIn>

        <div class="grid md:grid-cols-2 gap-12">
          {/* 基本情報 */}
          <FadeIn client:visible direction="up" delay={200}>
            <div class="border-l-4 border-constructivist-black pl-6">
              <dl class="space-y-6">
                <div>
                  <dt class="text-xs font-bold text-constructivist-gray uppercase tracking-widest font-body">NAME</dt>
                  <dd class="mt-1 text-lg text-constructivist-black font-body">Hironobu Nigo</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold text-constructivist-gray uppercase tracking-widest font-body">BORN</dt>
                  <dd class="mt-1 text-lg text-constructivist-black font-body">1984</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold text-constructivist-gray uppercase tracking-widest font-body">LOCATION</dt>
                  <dd class="mt-1 text-lg text-constructivist-black font-body">札幌市, 北海道, Japan</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold text-constructivist-gray uppercase tracking-widest font-body">ROLE</dt>
                  <dd class="mt-1 text-lg text-constructivist-black font-body">Software Engineer</dd>
                </div>
              </dl>
            </div>
          </FadeIn>

          {/* 自己紹介文 */}
          <FadeIn client:visible direction="up" delay={400}>
            <div class="text-constructivist-darkgray leading-relaxed space-y-4 font-body">
              <p>
                1984 年生まれ、北海道札幌市在住のソフトウェアエンジニアです。
                低レイヤーからアプリケーションまで、AI ツールを活用した幅広い領域でのシステム開発を行っています。
              </p>
              <p>
                趣味は音楽鑑賞、映画鑑賞、サイクリング。
                休日は自転車で札幌近郊を走ったり、お気に入りのカフェでコードを書いたりしています。
              </p>
            </div>
          </FadeIn>
        </div>
      </div>
    </section>

    {/* ═══════════════════ Skills ═══════════════════ */}
    <section id="skills" class="relative py-20 bg-constructivist-black overflow-hidden">
      {/* 装飾的幾何学図形 */}
      <div class="absolute top-10 right-10 w-24 h-24 border-4 border-constructivist-red opacity-40 transform rotate-45" aria-hidden="true"></div>
      <div class="absolute bottom-20 left-20 w-12 h-12 bg-constructivist-red opacity-30 transform -rotate-12" aria-hidden="true"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <FadeIn client:visible direction="left">
          <h2 class="font-sans text-5xl sm:text-6xl text-constructivist-cream tracking-tight mb-12">SKILLS</h2>
        </FadeIn>

        <AnimatedSkillBar client:visible groups={skills} />

        {/* GitHub Activity */}
        <div class="mt-16 border-l-4 border-constructivist-red pl-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xs font-bold text-constructivist-red uppercase tracking-widest font-body">GITHUB ACTIVITY</h3>
            <a
              href="https://github.com/nigoh"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-constructivist-gray hover:text-constructivist-red transition-colors font-body tracking-wider"
            >
              GITHUB.COM/NIGOH →
            </a>
          </div>

          {/* コントリビューション カレンダー */}
          <div class="mb-6">
            <p class="text-xs text-constructivist-gray mb-2 font-body">CONTRIBUTION CALENDAR</p>
            <div class="bg-constructivist-cream p-3">
              <img
                src="https://ghchart.rshah.org/D62828/nigoh"
                alt="GitHub Contribution Calendar"
                class="w-full"
                loading="lazy"
              />
            </div>
          </div>

          {/* Stats バッジ */}
          <div class="flex flex-wrap gap-2 mb-6">
            <img src="https://img.shields.io/github/stars/nigoh?style=for-the-badge&logo=github&label=Stars&color=D62828" alt="GitHub Stars" loading="lazy" class="h-7" />
            <img src="https://img.shields.io/github/followers/nigoh?style=for-the-badge&logo=github&label=Followers&color=D62828" alt="GitHub Followers" loading="lazy" class="h-7" />
          </div>

          {/* 言語分布グラフ */}
          {topLangs.length > 0 ? (
            <div>
              <p class="text-xs text-constructivist-gray mb-2 font-body">LANGUAGE DISTRIBUTION</p>
              <div class="flex h-3 overflow-hidden mb-3">
                {topLangs.map((lang) => (
                  <div
                    style={`width: ${lang.percent}%; background-color: ${lang.color};`}
                    title={`${lang.name}: ${lang.percent}%`}
                  />
                ))}
              </div>
              <div class="flex flex-wrap gap-x-4 gap-y-1.5">
                {topLangs.map((lang) => (
                  <div class="flex items-center gap-1.5">
                    <div class="w-3 h-3 shrink-0" style={`background-color: ${lang.color};`} />
                    <span class="text-xs text-constructivist-cream font-body font-medium">{lang.name}</span>
                    <span class="text-xs text-constructivist-gray font-body">{lang.percent}%</span>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <div class="flex flex-wrap gap-2">
              <img src="https://img.shields.io/badge/C%2FC++-00599C?style=flat-square&logo=c%2B%2B&logoColor=white" alt="C/C++" loading="lazy" />
              <img src="https://img.shields.io/badge/TypeScript-3178C6?style=flat-square&logo=typescript&logoColor=white" alt="TypeScript" loading="lazy" />
              <img src="https://img.shields.io/badge/Python-3776AB?style=flat-square&logo=python&logoColor=white" alt="Python" loading="lazy" />
              <img src="https://img.shields.io/badge/JavaScript-F7DF1E?style=flat-square&logo=javascript&logoColor=black" alt="JavaScript" loading="lazy" />
              <img src="https://img.shields.io/badge/Docker-2496ED?style=flat-square&logo=docker&logoColor=white" alt="Docker" loading="lazy" />
              <img src="https://img.shields.io/badge/Linux-FCC624?style=flat-square&logo=linux&logoColor=black" alt="Linux" loading="lazy" />
            </div>
          )}
        </div>
      </div>
    </section>

    {/* ═══════════════════ AI-Powered Development ═══════════════════ */}
    <section id="ai" class="relative py-20 overflow-hidden">
      {/* 装飾 — 斜めストライプ */}
      <div class="absolute -top-10 right-0 w-40 h-40 bg-constructivist-red transform rotate-45 opacity-10" aria-hidden="true"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <FadeIn client:visible direction="left">
          <h2 class="font-sans text-5xl sm:text-6xl text-constructivist-black tracking-tight mb-3">AI-POWERED DEV</h2>
          <p class="text-constructivist-darkgray mb-12 font-body">
            AI ツールを積極的に活用し、個人開発の生産性と品質を向上させています。
          </p>
        </FadeIn>

        <FadeIn client:visible direction="up" delay={200}>
        <div class="grid gap-0 sm:grid-cols-2">
          {/* Copilot SWE Agent */}
          <div class="border-2 border-constructivist-black p-6 hover:bg-constructivist-black hover:text-constructivist-cream transition-colors group">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-constructivist-red flex items-center justify-center">
                <svg class="w-5 h-5 text-constructivist-cream" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
                </svg>
              </div>
              <h3 class="font-sans text-xl tracking-wide text-constructivist-black group-hover:text-constructivist-cream">COPILOT SWE AGENT</h3>
            </div>
            <p class="text-constructivist-darkgray group-hover:text-constructivist-gray text-sm font-body">
              Issue からの自動実装・PR 作成。Focuso や QR Generator Web で SWE Agent をコントリビューターとして活用。
            </p>
          </div>

          {/* Codex */}
          <div class="border-2 border-constructivist-black border-l-0 sm:border-l-0 border-t-0 sm:border-t-2 p-6 hover:bg-constructivist-black hover:text-constructivist-cream transition-colors group">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-constructivist-red flex items-center justify-center">
                <svg class="w-5 h-5 text-constructivist-cream" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                </svg>
              </div>
              <h3 class="font-sans text-xl tracking-wide text-constructivist-black group-hover:text-constructivist-cream">OPENAI CODEX</h3>
            </div>
            <p class="text-constructivist-darkgray group-hover:text-constructivist-gray text-sm font-body">
              AGENTS.md を活用した AI エージェント駆動開発。stocko プロジェクトで Codex によるコード生成を実践。
            </p>
          </div>

          {/* MCP */}
          <div class="border-2 border-constructivist-black border-t-0 p-6 hover:bg-constructivist-black hover:text-constructivist-cream transition-colors group">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-constructivist-red flex items-center justify-center">
                <svg class="w-5 h-5 text-constructivist-cream" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                </svg>
              </div>
              <h3 class="font-sans text-xl tracking-wide text-constructivist-black group-hover:text-constructivist-cream">MCP</h3>
            </div>
            <p class="text-constructivist-darkgray group-hover:text-constructivist-gray text-sm font-body">
              GitHub, Playwright, Tailwind CSS 等の MCP サーバーを活用し、AI エージェントの能力を拡張。
            </p>
          </div>

          {/* Agent Configuration */}
          <div class="border-2 border-constructivist-black border-t-0 border-l-0 sm:border-l-0 p-6 hover:bg-constructivist-black hover:text-constructivist-cream transition-colors group">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-constructivist-red flex items-center justify-center">
                <svg class="w-5 h-5 text-constructivist-cream" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="font-sans text-xl tracking-wide text-constructivist-black group-hover:text-constructivist-cream">AGENT CONFIG</h3>
            </div>
            <p class="text-constructivist-darkgray group-hover:text-constructivist-gray text-sm font-body">
              .instructions.md, AGENTS.md, .kiro, Serena 等の設定でプロジェクトごとに AI エージェントの振る舞いをカスタマイズ。
            </p>
          </div>
        </div>
        </FadeIn>
      </div>
    </section>

    {/* ═══════════════════ Timeline ═══════════════════ */}
    <section id="timeline" class="relative py-20 bg-constructivist-black overflow-hidden">
      {/* 装飾 — 大きな円 */}
      <div class="absolute -bottom-20 -left-20 w-60 h-60 rounded-full border-8 border-constructivist-red opacity-20" aria-hidden="true"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <FadeIn client:visible direction="left">
          <h2 class="font-sans text-5xl sm:text-6xl text-constructivist-cream tracking-tight mb-12">TIMELINE</h2>
        </FadeIn>

        <AnimatedTimeline client:visible events={timeline} />
      </div>
    </section>

    {/* ═══════════════════ Portfolio ═══════════════════ */}
    <section id="portfolio" class="relative py-20 overflow-hidden">
      {/* 装飾 */}
      <div class="absolute top-0 right-0 w-2 h-full bg-constructivist-red" aria-hidden="true"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <FadeIn client:visible direction="left">
          <h2 class="font-sans text-5xl sm:text-6xl text-constructivist-black tracking-tight mb-12">PORTFOLIO</h2>
        </FadeIn>

        <FadeIn client:visible direction="up" delay={200}>
          <div class="grid gap-0 sm:grid-cols-2">
          {projects.map((project) => (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block border-2 border-constructivist-black p-6 hover:bg-constructivist-red hover:border-constructivist-red transition-all duration-200 group [&:nth-child(even)]:border-l-0 sm:[&:nth-child(even)]:border-l-0 [&:nth-child(n+3)]:border-t-0"
            >
              <h3 class="font-sans text-2xl text-constructivist-black group-hover:text-constructivist-cream mb-3 tracking-wide">
                {project.name}
              </h3>
              <p class="text-constructivist-darkgray group-hover:text-constructivist-cream text-sm mb-4 font-body">{project.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="text-xs font-bold text-constructivist-black group-hover:text-constructivist-cream border border-constructivist-black group-hover:border-constructivist-cream px-2 py-0.5 font-body tracking-wide">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
        </FadeIn>

        {/* Zenn 記事一覧 */}
        <FadeIn client:visible direction="up" delay={300}>
        <div class="mt-16">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xs font-bold text-constructivist-red uppercase tracking-widest font-body">BLOG (ZENN)</h3>
            <a
              href="https://zenn.dev/hironobunigo"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-constructivist-darkgray hover:text-constructivist-red transition-colors font-body tracking-wider"
            >
              すべて見る →
            </a>
          </div>

          {zennArticles.length > 0 ? (
            <div class="space-y-0">
              {zennArticles.map((article) => (
                <a
                  href={`https://zenn.dev/hironobunigo/articles/${article.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex border-2 border-constructivist-black border-b-0 last:border-b-2 overflow-hidden hover:bg-constructivist-black transition-all duration-200 group"
                >
                  <div class="flex-1 p-5 min-w-0">
                    <div class="flex items-center gap-2 mb-1.5">
                      <span class={`text-xs font-bold px-2 py-0.5 font-body tracking-wide ${article.article_type === 'tech' ? 'text-constructivist-cream bg-constructivist-red' : 'text-constructivist-black bg-constructivist-cream border border-constructivist-black'}`}>
                        {article.article_type === 'tech' ? 'TECH' : 'IDEA'}
                      </span>
                      <span class="text-xs text-constructivist-gray group-hover:text-constructivist-gray font-body">
                        {new Date(article.published_at).toLocaleDateString('ja-JP')}
                      </span>
                      {article.liked_count > 0 && (
                        <span class="text-xs text-constructivist-gray font-body">♥ {article.liked_count}</span>
                      )}
                    </div>
                    <p class="font-body font-semibold text-constructivist-black group-hover:text-constructivist-cream transition-colors leading-snug line-clamp-2">
                      {article.title}
                    </p>
                    <p class="text-xs text-constructivist-gray mt-1.5 font-body">zenn.dev</p>
                  </div>
                  <div class="w-20 shrink-0 bg-constructivist-red flex items-center justify-center">
                    <span class="text-3xl" role="img" aria-label="article emoji">{article.emoji}</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <a
              href="https://zenn.dev/hironobunigo"
              target="_blank"
              rel="noopener noreferrer"
              class="flex border-2 border-constructivist-black overflow-hidden hover:bg-constructivist-black transition-all duration-200 group"
            >
              <div class="flex-1 p-5">
                <p class="font-body font-semibold text-constructivist-black group-hover:text-constructivist-cream transition-colors">
                  技術記事を Zenn で発信しています
                </p>
                <p class="text-xs text-constructivist-gray mt-1.5 font-body">zenn.dev</p>
              </div>
              <div class="w-20 shrink-0 bg-constructivist-red flex items-center justify-center">
                <span class="text-2xl font-bold text-constructivist-cream font-sans">Z</span>
              </div>
            </a>
          )}
        </div>
        </FadeIn>
      </div>
    </section>

    {/* ═══════════════════ Contact ═══════════════════ */}
    <section id="contact" class="relative py-20 bg-constructivist-black overflow-hidden">
      {/* 装飾的幾何学 */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full border-4 border-constructivist-red opacity-10" aria-hidden="true"></div>
      <div class="absolute top-10 left-10 w-20 h-20 bg-constructivist-red transform rotate-12 opacity-20" aria-hidden="true"></div>

      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <FadeIn client:visible direction="none">
          <h2 class="font-sans text-5xl sm:text-6xl text-constructivist-cream tracking-tight mb-6">CONTACT</h2>
          <p class="text-constructivist-gray mb-10 font-body">
            お仕事のご依頼やお問い合わせは、GitHub からお気軽にどうぞ。
          </p>
          <a
            href="https://github.com/nigoh"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 bg-constructivist-red hover:bg-constructivist-cream text-constructivist-cream hover:text-constructivist-black font-sans text-xl tracking-wider transition-all duration-200"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            GITHUB.COM/NIGOH
          </a>
        </FadeIn>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
