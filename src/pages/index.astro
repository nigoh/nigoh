{/* 没入 3D ヒーローのスクロール進捗（§6.2）— #hero を通過する p=0→1 を --hero-p として設定する。
    ScrollTimeline 非対応環境でも動く rAF 実装（メインスレッド節約のため rAF で throttle）。
    ProunCanvas（3D）と .hero-h1-kinetic（H1）の両方がこの custom property を購読する。
    PRM 時は駆動しない（CSS が尺を 100vh に畳み、Proun は完成姿勢の静的 SVG にフォールバック）。 */}
<script>
  (() => {
    const hero = document.getElementById('hero');
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const total = hero.offsetHeight - window.innerHeight;
      const p = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / (total || 1)));
      hero.style.setProperty('--hero-p', p.toFixed(4));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
