---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FlowNode from '../components/FlowNode.astro';
import FlowRail from '../components/FlowRail.astro';
import SandLogo from '../components/SandLogo.astro';
import SandMeters from '../components/SandMeters.astro';
import CableBoard from '../components/CableBoard.astro';
import ToolBox from '../components/ToolBox.astro';
import type { BoardJob } from '../components/board';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import CareerGantt from '../components/CareerGantt.astro';
import type { GanttItem } from '../components/gantt';

interface ZennArticle {
  id: number;
  title: string;
  slug: string;
  emoji: string;
  article_type: 'tech' | 'idea';
  published_at: string;
  liked_count: number;
}

// ビルド時に Zenn API から記事を取得
let zennArticles: ZennArticle[] = [];
try {
  const res = await fetch('https://zenn.dev/api/articles?username=hironobunigo&order=latest&count=6');
  if (res.ok) {
    const data = await res.json();
    zennArticles = data.articles ?? [];
  }
} catch {
  // 取得失敗時はフォールバック表示
}

// ビルド時に GitHub API から公開リポジトリ一覧を取得（言語分布と Portfolio の両方で使用）
interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  pushed_at: string;
  fork: boolean;
  archived: boolean;
}

// Portfolio に載せないリポジトリ（業務関連）。CLAUDE.md「規約」参照
const excludedRepos = /faj|do.?hug/i;

let githubRepos: GitHubRepo[] = [];
try {
  const reposRes = await fetch(
    'https://api.github.com/users/nigoh/repos?per_page=100&type=owner',
    { headers: { Accept: 'application/vnd.github+json' } }
  );
  if (reposRes.ok) {
    githubRepos = await reposRes.json();
  }
} catch {
  // 取得失敗時は言語分布・Portfolio ともフォールバック表示
}

interface GitHubLang {
  name: string;
  percent: number;
  color: string;
}

const langColors: Record<string, string> = {
  TypeScript: '#3178C6',
  JavaScript: '#F1E05A',
  Python: '#3572A5',
  Java: '#B07219',
  Kotlin: '#A97BFF',
  'C++': '#F34B7D',
  C: '#555555',
  Rust: '#DEA584',
  Astro: '#FF5A03',
  HTML: '#E34C26',
  CSS: '#563D7C',
  Shell: '#89E051',
};

const langCounts: Record<string, number> = {};
for (const r of githubRepos) {
  if (r.language) langCounts[r.language] = (langCounts[r.language] ?? 0) + 1;
}
const langTotal = Object.values(langCounts).reduce((a, b) => a + b, 0);
const topLangs: GitHubLang[] = Object.entries(langCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([name, count]) => ({
    name,
    percent: Math.round((count / langTotal) * 100),
    color: langColors[name] ?? '#64748b',
  }));

// 4 分野・各 2〜4 項目（index.spec.md §3）。見出しは日本語、英語は小さな札（plug-2026.spec「文字」）
const skills = [
  {
    label: '言語',
    en: 'languages',
    items: [
      { name: 'C / C++', short: 'C/C++', level: 90, description: 'システムプログラミング・組み込み開発（8年以上）' },
      { name: 'Java', short: 'Java', level: 70, description: '組み込み Android アプリ（実務・2026〜）／オブジェクト指向設計' },
      { name: 'TypeScript / JavaScript', short: 'TS/JS', level: 70, description: '個人開発中心 — Web アプリ・型安全な実装' },
      { name: 'Python', short: 'Python', level: 65, description: 'スクリプティング・データ処理・自動化（約2年）' },
    ],
  },
  {
    label: 'プラットフォーム',
    en: 'platforms',
    items: [
      { name: 'Windows / MFC', short: 'MFC', level: 80, description: 'デスクトップアプリ・組み込みシステム開発（8年以上）' },
      { name: 'Linux (Ubuntu / Yocto)', short: 'Linux', level: 65, description: 'サーバー・組み込み Linux（約2年）' },
      { name: 'Android SDK', short: 'Android', level: 55, description: '専用端末向けネイティブアプリの Java 開発（実務・2026〜）' },
      { name: 'React / Astro', short: 'React', level: 65, description: '個人開発中心 — UI 構築・静的サイト' },
    ],
  },
  {
    label: '開発と基盤',
    en: 'dev & infra',
    items: [
      { name: 'Git / GitLab', short: 'Git', level: 85, description: 'バージョン管理・CI/CD・チーム開発フロー整備（約6年）' },
      { name: 'Docker', short: 'Docker', level: 75, description: 'コンテナ化・開発環境標準化（約4年）' },
      { name: 'RDB (PostgreSQL / Oracle)', short: 'RDB', level: 70, description: 'DB 設計・クエリ最適化（約3年）' },
    ],
  },
  {
    label: 'AI 駆動開発',
    en: 'ai-driven dev',
    items: [
      { name: 'AI コーディングエージェント', short: 'AI エージェント', level: 85, description: 'Claude Code / GitHub Copilot / Codex — サブエージェント・フック・SWE Agent による自律開発' },
      { name: 'MCP / エージェント設計', short: 'MCP', level: 80, description: 'MCP サーバーと AGENTS.md / CLAUDE.md / .kiro でエージェントの能力・挙動を拡張' },
    ],
  },
];

// 経歴。start / end は帯グラフ用のおおよその年（end: null は進行中）。
interface CareerItem {
  period: string;
  industry: string;
  phase: string;
  techs: string[];
  gantt: GanttItem;
}

const career: CareerItem[] = [
  {
    period: '2026/04〜現在',
    industry: '組み込み Android（専用端末向けアプリ）',
    phase: '詳細設計・実装・試験',
    techs: ['Java', 'Android SDK', 'Android Studio', 'Gradle', 'Git'],
    gantt: { label: '組み込み Android', start: 2026.25, end: null, note: '2026/04〜' },
  },
  {
    period: '2025（約1年）',
    industry: '組み込み制御（社会インフラ機器・コアシステム）',
    phase: '詳細設計・実装・試験',
    techs: ['C', 'Linux (Yocto)', 'Make'],
    gantt: { label: '社会インフラ機器・コア', start: 2025, end: 2026, note: '約1年' },
  },
  {
    period: '2022、2025（約3年）',
    industry: '組み込み制御（社会インフラ機器・制御システム）',
    phase: '要件定義〜マネジメント（サブリーダー）',
    techs: ['C++', 'MFC', 'Git', 'Docker'],
    gantt: { label: '社会インフラ機器・制御', start: 2022, end: 2025, note: '約3年' },
  },
  {
    period: '2021～2022（約1年）',
    industry: '車載地図データツール',
    phase: '設計・実装・マネジメント',
    techs: ['C++', 'Oracle', 'VS Code'],
    gantt: { label: '車載地図データツール', start: 2021, end: 2022, note: '約1年' },
  },
  {
    period: '2020～2021（約1年）',
    industry: '車載地図データ変換ツール',
    phase: '設計〜インフラ構築',
    techs: ['Java', 'C++', 'PostgreSQL', 'AWS'],
    gantt: { label: '車載地図データ変換', start: 2020, end: 2021, note: '約1年' },
  },
  {
    period: '2018～2020（約2年）',
    industry: '車載地図データツール（サブリーダー）',
    phase: '設計・実装・マネジメント',
    techs: ['C++', 'Python', 'PostgreSQL'],
    gantt: { label: '車載地図データツール', start: 2018, end: 2020, note: '約2年' },
  },
  {
    period: '2016～2018（約1年半）',
    industry: '自動運転用3D地図・試作モジュール開発',
    phase: '詳細設計・実装・試験',
    techs: ['C++11', 'Java', 'Python', 'MongoDB'],
    gantt: { label: '自動運転用 3D 地図・試作', start: 2016.5, end: 2018, note: '約1年半' },
  },
];

// 経歴のケーブルボード（C）：プラグを差した仕事をモニターに出す
const boardJobs: BoardJob[] = career.map((c) => ({
  period: c.period,
  short: c.gantt.label,
  industry: c.industry,
  phase: c.phase,
  techs: c.techs,
  ongoing: c.gantt.end === null,
}));

// 帯グラフの目盛り（2016〜2027）と、ビルドした日（進行中の帯の終わり）
const ganttFrom = 2016;
const ganttTo = 2027;
const buildDate = new Date();
const nowYear = Math.min(ganttTo, buildDate.getFullYear() + buildDate.getMonth() / 12);
// 帯グラフは古い順に上から
const ganttItems: GanttItem[] = [...career].reverse().map((c) => c.gantt);

// Portfolio — GitHub の公開リポジトリからビルド時に自動生成（fork・アーカイブ・除外パターンを除く）。
// 直近 90 日以内に push があるものは「進行中」の列、それより前は「一区切り」の列（案 C の作品ボード）。
interface ProjectCard {
  name: string;
  description: string;
  url: string;
  tags: string[];
  wip: boolean;
}

const WIP_WINDOW_MS = 90 * 24 * 60 * 60 * 1000;
const buildTime = buildDate.getTime();

const githubProjects: ProjectCard[] = githubRepos
  .filter((r) => !r.fork && !r.archived && !excludedRepos.test(r.name))
  .sort((a, b) => new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime())
  .slice(0, 8)
  .map((r) => ({
    name: r.name,
    description: r.description ?? '自己開発プロジェクト。詳細は GitHub リポジトリを参照。',
    url: r.html_url,
    tags: r.language ? [r.language] : [],
    wip: buildTime - new Date(r.pushed_at).getTime() < WIP_WINDOW_MS,
  }));

// API 取得失敗時のフォールバック（代表的な公開リポジトリのみ）
const fallbackProjects: ProjectCard[] = [
  {
    name: 'nigoh',
    description: 'このサイトのソースコード。Astro + Tailwind CSS で構築した個人紹介サイト。',
    url: 'https://github.com/nigoh/nigoh',
    tags: ['Astro', 'TypeScript'],
    wip: true,
  },
  {
    name: 'Juml',
    description: '開発中の自己開発プロジェクト。詳細は GitHub リポジトリを参照。',
    url: 'https://github.com/nigoh/Juml',
    tags: [],
    wip: true,
  },
  {
    name: 'qr-generator-web',
    description: 'QRコード生成Webアプリ。Copilot + Serena による AI ペアプログラミングで開発。',
    url: 'https://github.com/nigoh/qr-generator-web',
    tags: ['TypeScript', 'React'],
    wip: false,
  },
  {
    name: 'stocko',
    description: '株価情報取得ツール。OpenAI Codex & AGENTS.md を活用した AI エージェント開発。',
    url: 'https://github.com/nigoh/stocko',
    tags: ['JavaScript', 'AI: Codex + AGENTS.md'],
    wip: false,
  },
];

const projects = githubProjects.length > 0 ? githubProjects : fallbackProjects;
const boardColumns: { key: string; label: string; icon: IconName; tone: string; items: ProjectCard[] }[] = [
  { key: 'wip', label: '進行中', icon: 'circle-play', tone: 'text-ui-teal', items: projects.filter((p) => p.wip) },
  { key: 'done', label: '一区切り', icon: 'circle-check', tone: 'text-ui-ok', items: projects.filter((p) => !p.wip) },
];

// AI 駆動開発のツール・やり方（アイコンは Lucide）
interface AiTool {
  title: string;
  body: string;
  icon: IconName;
}

const aiTools: AiTool[] = [
  {
    title: 'Claude Code',
    body: 'designer / frontend のサブエージェントと PreToolUse フックを組み合わせ、役割分担と安全策を備えた自律開発を実践。このサイト自体も Claude Code で構築・改善。',
    icon: 'terminal',
  },
  {
    title: 'Copilot SWE Agent',
    body: 'Issue からの自動実装・PR 作成。Focuso や QR Generator Web で SWE Agent をコントリビューターとして活用。',
    icon: 'sparkles',
  },
  {
    title: 'OpenAI Codex',
    body: 'AGENTS.md を活用した AI エージェント駆動開発。stocko プロジェクトで Codex によるコード生成を実践。',
    icon: 'code-xml',
  },
  {
    title: 'MCP',
    body: 'GitHub, Playwright, Tailwind CSS 等の MCP サーバーを活用し、AI エージェントの能力を拡張。',
    icon: 'plug',
  },
  {
    title: 'エージェントの設定',
    body: '.instructions.md, AGENTS.md, CLAUDE.md, .kiro 等の設定でプロジェクトごとに AI エージェントの振る舞いをカスタマイズ。',
    icon: 'sliders-horizontal',
  },
  {
    title: '仕様駆動開発',
    body: 'specs/** の仕様を AI と更新しながら実装し、受入条件（チェックリスト）で検証する仕様駆動開発（SDD）を実践。',
    icon: 'clipboard-check',
  },
];

const interests = [
  { title: 'RAG / AI 意思決定支援', body: '生成 AI を用いた RAG（検索拡張生成）による意思決定支援アプリの開発に強い関心を持ち、個人開発で実践中。' },
  { title: '開発フロー整備', body: 'Docker による環境標準化・Git/GitLab を活用したチーム開発フロー設計・CI/CD パイプライン構築。' },
  { title: '技術普及・後進育成', body: 'チームへの技術指導・コードレビュー文化の醸成。AI ツールを活用した生産性向上の横展開。' },
];

const profile = [
  { k: '名前', v: 'Hironobu Nigo' },
  { k: '生まれ', v: '1984', mono: true },
  { k: '拠点', v: '札幌市, 北海道, Japan' },
  { k: '役割', v: 'Software Engineer' },
];

const heroKeywords = ['C/C++', 'Java', 'TypeScript', 'Python'];

// GitHub のマーク（塗りの形。Lucide ではない）
const githubMark =
  'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z';
---

<BaseLayout title="H.NIGO | Software Engineer">
  <Header />

  <div class="mx-auto max-w-[1200px] px-4 pb-6 pt-[88px] sm:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 lg:px-8">
    {/* 流れ：セクション＝ブロックを、左のティールのケーブルでつなぐ（plug-2026.spec「構図」） */}
    <main id="main-content" class="flow">

      {/* ═══ 01 はじめ（start）═══ */}
      <FlowNode id="hero" n="01" title="はじめ" en="start" hideTitle>
        <div class="flex flex-col gap-5">
          <h1 id="hero-title" class="sr-only">H.Nigo（nigoh）</h1>
          {/* A 砂のロゴ（physics-2026.spec）。JS 無しではベクターのロゴ */}
          <SandLogo />
          <p class="font-mono text-sm tracking-wider text-ui-muted">H.NIGO · SOFTWARE ENGINEER · SAPPORO</p>
          <p class="text-[clamp(1.75rem,1.1rem+2.6vw,2.75rem)] font-black leading-[1.25]">
            <span class="inline-block">低レイヤーから、</span><span class="inline-block">アプリまで<span class="text-ui-coral">.</span></span>
          </p>
          <p class="max-w-[60ch]">
            C/C++, Java, TypeScript, Python を使い、AI ツールを活用してものづくりをしています。
            2026 年からは組み込み Android（専用端末向けアプリ）の開発に Java で関わっています。
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="https://github.com/nigoh" target="_blank" rel="noopener noreferrer" class="btn btn-pri">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d={githubMark}></path></svg>
              GitHub を見る
            </a>
            <a href="https://zenn.dev/hironobunigo" target="_blank" rel="noopener noreferrer" class="btn btn-sec">
              Zenn の記事
              <Icon name="arrow-up-right" size={17} />
            </a>
          </div>
          <ul class="flex flex-wrap gap-2" aria-label="主な言語">
            {heroKeywords.map((k) => <li class="tag">{k}</li>)}
          </ul>
        </div>
      </FlowNode>

      {/* ═══ 02 自己紹介 ═══ */}
      <FlowNode id="about" n="02" title="自己紹介" en="about" icon="file-text">
        <p class="mb-6 max-w-[60ch] text-lg font-bold">あるものを大切にしながら、変化にも柔軟に対応できるエンジニアを目指しています。</p>
        <div class="grid gap-6 md:grid-cols-[minmax(0,240px)_minmax(0,1fr)] md:gap-8">
          <dl class="well m-0 grid content-start gap-4 p-5">
            {
              profile.map((row) => (
                <div>
                  <dt class="text-sm text-ui-muted">{row.k}</dt>
                  <dd class:list={['m-0 font-bold', { 'font-mono': row.mono }]}>{row.v}</dd>
                </div>
              ))
            }
          </dl>
          <div class="max-w-[68ch] space-y-4">
            <p>
              1984 年生まれ、北海道札幌市在住のソフトウェアエンジニアです。
              低レイヤーからアプリケーションまで、幅広い領域でのシステム開発を行っています。
              主に C/C++, Java, TypeScript, Python を使用し、AI ツールを活用し個人開発も行っています。
            </p>
            <p>
              2026 年からは組み込み Android（専用端末向けアプリ）の開発に Java で従事し、
              詳細設計・実装・試験を担当しています。
              これまで C++ / C / Java を中心にオブジェクト指向設計を実践してきました。
              変更容易性と関心の分離を意識した設計・実装を重視し、後進への技術指導も対応可能です。
              Git / GitLab を活用したチーム開発フロー整備の経験もあります。
            </p>
            <p>
              趣味は音楽鑑賞、映画鑑賞、サイクリング。
              好きなアーティストは、チャーリーパーカー。
              休日は自転車で札幌近郊を走ったり、読書をしたりしています。
            </p>
          </div>
        </div>
      </FlowNode>

      {/* ═══ 03 スキル ═══ */}
      <FlowNode id="skills" n="03" title="スキル" en="skills" icon="code">
        <div class="grid gap-4 md:grid-cols-2">
          {
            skills.map((group) => (
              <div class="well p-5">
                <h3 class="flex items-baseline justify-between gap-3 text-lg font-bold">
                  {group.label}
                  <span class="font-mono text-sm font-normal text-ui-muted">{group.en}</span>
                </h3>
                {/* B 砂のメーター（physics-2026.spec）。数は管の下、読み上げは下の一覧 */}
                <SandMeters items={group.items.map((it) => ({ short: it.short, level: it.level }))} />
                <ul class="mt-4 space-y-2.5">
                  {group.items.map((item) => (
                    <li>
                      <span class="font-bold">{item.name}</span>
                      <span class="sr-only">（習熟度 {item.level}）</span>
                      <p class="text-sm text-ui-muted">{item.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        {/* GitHub の活動 */}
        <div class="mt-10">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-lg font-bold">GitHub の活動 <span class="ml-1 font-mono text-sm font-normal text-ui-muted">個人開発</span></h3>
            <a href="https://github.com/nigoh" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center gap-1 font-bold text-ui-teal hover:underline">
              github.com/nigoh <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
          <div class="well mt-3 p-3 sm:p-4">
            <img
              src="https://ghchart.rshah.org/167D6B/nigoh"
              alt="GitHub のコントリビューションの草（1 年分）"
              class="contrib-img w-full"
              loading="lazy"
            />
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <img src="https://img.shields.io/github/stars/nigoh?style=flat-square&logo=github&label=Stars&color=167D6B" alt="GitHub Stars" loading="lazy" class="h-5" />
            <img src="https://img.shields.io/github/followers/nigoh?style=flat-square&logo=github&label=Followers&color=167D6B" alt="GitHub Followers" loading="lazy" class="h-5" />
          </div>
          {
            topLangs.length > 0 && (
              <div class="mt-5">
                <p class="mb-2 text-sm text-ui-muted">言語の割合（個人開発のリポジトリより）</p>
                <div class="flex h-3 gap-[3px]" aria-hidden="true">
                  {topLangs.map((lang) => (
                    <div class="rounded-[3px]" style={`width: ${lang.percent}%; background-color: ${lang.color};`} title={`${lang.name}: ${lang.percent}%`} />
                  ))}
                </div>
                <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
                  {topLangs.map((lang) => (
                    <li class="flex items-center gap-2 text-sm">
                      <span class="h-3 w-3 shrink-0 rounded-[3px]" style={`background-color: ${lang.color};`} aria-hidden="true" />
                      <span class="font-bold">{lang.name}</span>
                      <span class="font-mono text-ui-muted">{lang.percent}%</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </FlowNode>

      {/* ═══ 04 AI と開発 ═══ */}
      <FlowNode id="ai" n="04" title="AI と開発" en="ai" icon="users">
        <p class="max-w-[66ch]">
          Claude Code・GitHub Copilot・OpenAI Codex・MCP を活用し、個人開発のすべての工程を AI と協働しています。
          Issue 起票から実装・PR・レビューまで AI ドリブンで回すワークフローを実践中。
        </p>
        {/* D 道具箱（physics-2026.spec）。飾り。同じ内容は下のカード */}
        <ToolBox />
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {
            aiTools.map((tool) => (
              <li class="well flex flex-col gap-2 p-5">
                <div class="flex items-center gap-3">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-btn bg-ui-teal-tint text-ui-teal-ink" aria-hidden="true">
                    <Icon name={tool.icon} />
                  </span>
                  <h3 class="text-lg font-bold">{tool.title}</h3>
                </div>
                <p class="text-ui-muted">{tool.body}</p>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-10 flex items-center gap-2 text-lg font-bold">
          <Icon name="lightbulb" class="text-ui-muted" />
          関心ごと
        </h3>
        <ul class="mt-3 grid gap-3 md:grid-cols-3">
          {
            interests.map((it) => (
              <li class="well p-5">
                <h4 class="font-bold">{it.title}</h4>
                <p class="mt-1.5 text-ui-muted">{it.body}</p>
              </li>
            ))
          }
        </ul>
      </FlowNode>

      {/* ═══ 05 経歴（案 B の帯グラフ ＋ 仕事の一覧）═══ */}
      <FlowNode id="career" n="05" title="経歴" en="career" icon="git-branch">
        <p class="mb-5 text-sm text-ui-muted">
          注: クライアント名・案件番号・具体的な機器名/製品名・詳細な期間は非掲載。業種・技術領域のみ一般化して記載。
        </p>
        <CareerGantt items={ganttItems} from={ganttFrom} to={ganttTo} now={nowYear} />

        {/* C 差すと見えるケーブル（physics-2026.spec）。プラグを差した仕事をモニターに出す */}
        <h3 class="mb-3 mt-10 flex items-center gap-2 text-lg font-bold">
          <Icon name="plug" class="text-ui-muted" />
          差して見る
          <span class="font-mono text-sm font-normal text-ui-muted">プラグをつまんで、仕事のコンセントへ</span>
        </h3>
        <CableBoard jobs={boardJobs} />
      </FlowNode>

      {/* ═══ 06 作品（案 C の作品ボード ＋ Zenn）═══ */}
      <FlowNode id="portfolio" n="06" title="作品" en="portfolio" icon="globe">
        <p class="max-w-[66ch] text-ui-muted">
          自己開発のプロジェクト。GitHub の公開リポジトリからビルドのたびに作り直します。最終更新が 90 日以内なら「進行中」です。
        </p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {
            boardColumns.map((col) => (
              <div class="well flex flex-col gap-3 p-3 sm:p-4">
                <h3 class="flex items-center gap-2 px-1 font-bold text-ui-muted">
                  <Icon name={col.icon} class={col.tone} />
                  {col.label}
                  <span class="ml-auto font-mono text-sm font-normal">{col.items.length}</span>
                </h3>
                {col.items.length > 0 ? (
                  <ul class="flex flex-col gap-3">
                    {col.items.map((project) => (
                      <li>
                        <a href={project.url} target="_blank" rel="noopener noreferrer" class="card-link flex-col gap-2 p-4">
                          <span class="flex items-start justify-between gap-3">
                            <span class="break-words text-lg font-bold leading-snug">{project.name}</span>
                            <Icon name="arrow-up-right" class="mt-1 shrink-0 text-ui-muted" />
                          </span>
                          <span class="text-ui-muted">{project.description}</span>
                          <span class="flex flex-wrap items-center gap-2">
                            {project.wip && (
                              <span class="chip chip-teal">
                                <Icon name="refresh-cw" size={15} />
                                製作中
                              </span>
                            )}
                            {project.tags.map((tag) => (
                              <span class="tag">{tag}</span>
                            ))}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="px-1 pb-1 text-sm text-ui-muted">いまはありません。</p>
                )}
              </div>
            ))
          }
        </div>

        {/* Zenn の記事 */}
        <div class="mt-10">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="pen-line" class="text-ui-muted" />
              書いたもの
              <span class="font-mono text-sm font-normal text-ui-muted">zenn</span>
            </h3>
            <a href="https://zenn.dev/hironobunigo" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center gap-1 font-bold text-ui-teal hover:underline">
              すべて見る <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
          {
            zennArticles.length > 0 ? (
              <ul class="mt-3 grid gap-3 md:grid-cols-2">
                {zennArticles.map((article) => (
                  <li>
                    <a href={`https://zenn.dev/hironobunigo/articles/${article.slug}`} target="_blank" rel="noopener noreferrer" class="card-link h-full items-start gap-4 p-4">
                      <span class="well grid h-14 w-14 shrink-0 place-items-center text-2xl" aria-hidden="true">{article.emoji}</span>
                      <span class="flex min-w-0 flex-col gap-1.5">
                        <span class="flex flex-wrap items-center gap-2 text-sm text-ui-muted">
                          <span class:list={['chip', article.article_type === 'tech' ? 'chip-teal' : 'chip-mute']}>
                            {article.article_type === 'tech' ? '技術' : 'アイデア'}
                          </span>
                          <span class="font-mono">{new Date(article.published_at).toLocaleDateString('ja-JP')}</span>
                          {article.liked_count > 0 && (
                            <span class="inline-flex items-center gap-1 font-mono">
                              <Icon name="heart" size={14} />
                              <span class="sr-only">いいね </span>
                              {article.liked_count}
                            </span>
                          )}
                        </span>
                        <span class="line-clamp-2 font-bold leading-snug">{article.title}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <a href="https://zenn.dev/hironobunigo" target="_blank" rel="noopener noreferrer" class="card-link mt-3 items-center gap-4 p-4">
                <span class="well grid h-14 w-14 shrink-0 place-items-center font-mono text-xl font-bold" aria-hidden="true">Z</span>
                <span class="font-bold">技術記事を Zenn で発信しています</span>
              </a>
            )
          }
        </div>
      </FlowNode>

      {/* ═══ 07 連絡（end）═══ */}
      <FlowNode id="contact" n="07" title="連絡" en="end">
        <p class="max-w-[60ch] text-lg">お仕事のご依頼やお問い合わせは、GitHub からお気軽にどうぞ。</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://github.com/nigoh" target="_blank" rel="noopener noreferrer" class="btn btn-pri min-h-[52px] px-6 text-lg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d={githubMark}></path></svg>
            github.com/nigoh
          </a>
          <a href="https://zenn.dev/hironobunigo" target="_blank" rel="noopener noreferrer" class="btn btn-sec min-h-[52px] px-6">
            Zenn
            <Icon name="arrow-up-right" size={17} />
          </a>
        </div>
      </FlowNode>
    </main>

    <aside class="hidden lg:block">
      <FlowRail />
    </aside>
  </div>

  <Footer />
</BaseLayout>
