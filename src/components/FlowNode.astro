---
// セクション＝作業台のブロック（specs/plug-2026.spec.md「構図」）。
// 行（.flow-row）が左のケーブルと枝・分かれ目の点を描き、ブロックの左の縁に
// ティールのコンセントとコーラルのプラグ（.flow-plug）を置く。中身は slot。
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  id: string;
  n: string;
  title: string;
  en: string;
  /** ブロックの頭のアイコン（無いときは start / end の札を出す） */
  icon?: IconName;
  /** 見出しを出さないブロック（ヒーロー）。中で自分の h1 を持つ */
  hideTitle?: boolean;
}

const { id, n, title, en, icon, hideTitle = false } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class="flow-row" data-state="todo" aria-labelledby={headingId}>
  <span class="flow-jn" aria-hidden="true"></span>
  {/* 描く順：刃（コンセントの下に隠れる）→ コンセント → 穴 → 輪 → プラグの胴 */}
  <svg class="flow-plug" viewBox="0 0 44 28" aria-hidden="true" focusable="false">
    <g class="fp-move">
      <rect x="20" y="9" width="12" height="3" rx="1.2"></rect>
      <rect x="20" y="16" width="12" height="3" rx="1.2"></rect>
    </g>
    <circle class="fp-socket" cx="30" cy="14" r="12"></circle>
    <g class="fp-holes">
      <rect x="25" y="8.8" width="10" height="3.2" rx="1.6"></rect>
      <rect x="25" y="16" width="10" height="3.2" rx="1.6"></rect>
    </g>
    <circle class="fp-ring" cx="30" cy="14" r="12"></circle>
    <g class="fp-move">
      <rect x="6" y="4" width="18" height="20" rx="5"></rect>
    </g>
  </svg>

  <div class="flow-node">
    <div class="node-head">
      {
        icon ? (
          <span class="node-ic" aria-hidden="true">
            <Icon name={icon} />
          </span>
        ) : (
          <span class="tag">{en}</span>
        )
      }
      {
        hideTitle ? (
          <span class="font-mono text-sm text-ui-muted" aria-hidden="true">{n}</span>
        ) : (
          <h2 id={headingId} class="text-[1.625rem] font-black leading-[1.25] sm:text-[2rem]">
            {title}
            {icon && <span class="ml-2 align-middle font-mono text-sm font-normal text-ui-muted">{en}</span>}
          </h2>
        )
      }
      {/* 状態の札は飾り（同じ情報は目次が aria-current で持つ） */}
      <span class="state ml-auto" aria-hidden="true">
        <span class="chip chip-ok is-done"><Icon name="circle-check" size={15} />完了</span>
        <span class="chip chip-teal is-current"><Icon name="refresh-cw" size={15} />いまここ</span>
        <span class="chip chip-mute is-todo"><Icon name="circle-dashed" size={15} />まだ</span>
      </span>
    </div>
    <div class="mt-5">
      <slot />
    </div>
  </div>
</section>
