---
// 経歴の帯グラフ（案 B 実行パネルの「時系列」）— specs/plug-2026.spec.md
// 年の目盛り（1 年ごとの縦線・2 年ごとの数）に合わせて、仕事ごとの期間を帯で描く。
// 完了＝ティールの塗り、進行中＝点の模様（色だけに頼らない）。狭い画面では帯グラフだけ横に動かす。
import type { GanttItem } from './gantt';

interface Props {
  items: GanttItem[];
  from: number;
  to: number;
  now: number;
}

const { items, from, to, now } = Astro.props;
const span = to - from;
const pct = (y: number): number => ((y - from) / span) * 100;
const ticks: number[] = [];
for (let y = from; y < to; y += 2) ticks.push(y);
---

<div class="well overflow-x-auto p-4 sm:p-5">
  <div class="gantt" style={`--years: ${span};`}>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm text-ui-muted">
      <p><span class="font-bold text-ui-fg">時系列</span> · <span class="font-mono">{items.length} 件 · {from}–{Math.floor(now)}</span></p>
      <p class="flex items-center gap-4">
        <span class="flex items-center gap-1.5"><i class="gantt-key" aria-hidden="true"></i>完了</span>
        <span class="flex items-center gap-1.5"><i class="gantt-key is-now" aria-hidden="true"></i>進行中</span>
      </p>
    </div>
    <div class="gantt-row" aria-hidden="true">
      <span class="gantt-label"></span>
      <div class="relative h-6 font-mono text-sm text-ui-muted">
        {ticks.map((y) => <span class:list={['absolute', { '-translate-x-1/2': y !== from }]} style={`left: ${pct(y)}%;`}>{y}</span>)}
      </div>
    </div>
    <ol class="m-0 list-none p-0">
      {
        items.map((it) => {
          const end = it.end ?? now;
          // 右端に近い帯は、長さの文字を帯の左に置く（目盛りの外にはみ出さない）
          const noteBefore = it.end === null || pct(end) > 78;
          return (
            <li class="gantt-row border-t border-ui-line text-sm">
              <span class="gantt-label truncate" title={it.label}>{it.label}</span>
              <div class="gantt-track">
                <span
                  class:list={['gantt-bar', { 'is-now': it.end === null }]}
                  style={`left: ${pct(it.start)}%; width: ${pct(end) - pct(it.start)}%;`}
                ></span>
                <span
                  class="absolute top-[6px] whitespace-nowrap px-1.5 font-mono text-sm text-ui-muted"
                  style={noteBefore ? `right: ${100 - pct(it.start)}%;` : `left: ${pct(end)}%;`}
                >
                  {it.note}
                </span>
              </div>
            </li>
          );
        })
      }
    </ol>
    <p class="mt-3 text-sm text-ui-muted">期間はおおよそ。名前は一般化して記載しています。</p>
  </div>
</div>
