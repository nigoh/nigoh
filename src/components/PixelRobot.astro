---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// ピクセルロボット騎士 — 青い兜、赤い鎧、マント、ブーツ
const palette: Record<string, string> = {
  B: '#60a5fa', // blue-400 — 兜
  e: '#fbbf24', // amber-400 — 目
  R: '#ef4444', // red-500 — 鎧・ブーツ
  D: '#991b1b', // red-900 — マント
  S: '#fdba74', // orange-300 — 肌
};

const grid = [
  '...BBB...',
  '..BBBBB..',
  '..BeBeB..',
  '..BBBBB..',
  '...RRR...',
  '.SRRRRRS.',
  'DDRRRRRDD',
  'DD.RRR.DD',
  '....R....',
  '...R.R...',
  '...R.R...',
  '..RR.RR..',
];

const W = grid[0].length;
const H = grid.length;

const pixels: { x: number; y: number; color: string }[] = [];
for (let r = 0; r < H; r++) {
  for (let c = 0; c < grid[r].length; c++) {
    const ch = grid[r][c];
    if (ch !== '.' && palette[ch]) {
      pixels.push({ x: c, y: r, color: palette[ch] });
    }
  }
}
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class={className}
  role="img"
  aria-label="Pixel Robot Knight"
  xmlns="http://www.w3.org/2000/svg"
  shape-rendering="crispEdges"
>
  {pixels.map((p) => (
    <rect x={p.x} y={p.y} width="0.9" height="0.9" fill={p.color} />
  ))}
</svg>
