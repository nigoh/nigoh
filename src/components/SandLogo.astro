---
// A 砂のロゴ（specs/physics-2026.spec.md）。JS 無しではベクターのロゴをそのまま出す。
// ボタン（傾き・もとに戻す）と案内は、ロゴに重ねず受け皿の下の 1 行に置く（specs/shell-2026.spec.md「スマホの見直し」）。
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---

<div class="sand-logo" data-sand-logo>
  <div class="sand-tray well">
    <Logo id="hero" class="sand-fallback" />
    <canvas class="sand-canvas" aria-hidden="true"></canvas>
  </div>
  <div class="sand-bar">
    <p class="sand-hint" data-hint hidden>なぞると崩れる・押すと砂が出る</p>
    <div class="sand-tools">
      <button type="button" class="btn btn-sec tray-btn" data-gyro hidden aria-label="傾きで動かす" title="傾きで動かす">
        <Icon name="smartphone" size={17} />
        <span class="tray-label">傾きで動かす</span>
      </button>
      <button type="button" class="btn btn-sec tray-btn" data-reform hidden aria-label="ロゴをもとに戻す" title="もとに戻す">
        <Icon name="rotate-ccw" size={17} />
        <span class="tray-label">もとに戻す</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { initSandLogo } from '../scripts/sandLogo';
  initSandLogo();
</script>
