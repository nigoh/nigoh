---
const base = import.meta.env.BASE_URL;

const sections = [
  { label: 'ABOUT', href: '#about' },
  { label: 'SKILLS', href: '#skills' },
  { label: 'AI', href: '#ai' },
  { label: 'CAREER', href: '#career' },
  { label: 'PORTFOLIO', href: '#portfolio' },
  { label: 'CONTACT', href: '#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-constructivist-black">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    {/* ロゴ — 構成主義的ボールド */}
    <a href={base} class="font-sans text-2xl tracking-widest text-constructivist-cream hover:text-constructivist-red transition-colors">
      H.NIGO
    </a>

    {/* デスクトップナビ */}
    <ul class="hidden sm:flex items-center gap-0">
      {sections.map((item) => (
        <li>
          <a
            href={item.href}
            class="misprint-text nav-link block px-3 py-2 text-sm font-sans tracking-wider text-constructivist-cream"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    {/* モバイルメニューボタン */}
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="メニュー"
      class="sm:hidden p-2.5 text-constructivist-cream hover:text-constructivist-red transition-colors"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="square" d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </nav>

  {/* モバイルメニュー */}
  <div id="mobile-menu" class="hidden sm:hidden bg-constructivist-black border-t-2 border-constructivist-red">
    <ul class="px-4 py-3 space-y-0">
      {sections.map((item) => (
        <li>
          <a
            href={item.href}
            class="misprint-text nav-link block px-3 py-3 font-sans text-sm tracking-wider text-constructivist-cream hover:bg-constructivist-darkgray"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  // モバイルメニュー開閉
  document.getElementById('mobile-menu-btn').addEventListener('click', function() {
    var menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
  });
  // メニューリンクをクリックしたら閉じる
  document.querySelectorAll('#mobile-menu a').forEach(function(link) {
    link.addEventListener('click', function() {
      document.getElementById('mobile-menu').classList.add('hidden');
    });
  });

  // T6c ナビ現在地 — 可視セクションに対応するリンクへ aria-current="true" を付与
  // （装飾ではなく情報なので aria で公開する — trends-2026-refresh.spec §7c）
  (function() {
    var links = Array.prototype.slice.call(document.querySelectorAll('.nav-link'));
    var byId = {};
    links.forEach(function(link) {
      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;
      var id = href.slice(1);
      (byId[id] = byId[id] || []).push(link);
    });
    var targets = Object.keys(byId)
      .map(function(id) { return document.getElementById(id); })
      .filter(Boolean);
    if (!('IntersectionObserver' in window) || targets.length === 0) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        links.forEach(function(link) { link.removeAttribute('aria-current'); });
        byId[entry.target.id].forEach(function(link) {
          link.setAttribute('aria-current', 'true');
        });
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    targets.forEach(function(target) { observer.observe(target); });
  })();
</script>
