---
// 上の帯（specs/shell-2026.spec.md「構図」）：[ロゴ nigoh] ……… [明るい/暗い]
// 段の切り替えは「流れ」（StageRail.astro）が受け持つ。
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---

<a href="#main-content" class="skip-link">本文へスキップ</a>

<header class="topbar" id="topbar">
  <div class="mx-auto flex h-full max-w-[1440px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href="#hero" class="flex h-11 items-center rounded-btn" aria-label="nigoh（はじめへ）">
      <Logo id="top" class="h-[26px] w-auto sm:h-[30px]" />
    </a>
    <button id="theme-switch" type="button" class="icon-btn" aria-pressed="false" aria-label="暗い画面にする">
      <Icon name="moon" class="theme-moon" />
      <Icon name="sun" class="theme-sun" />
    </button>
  </div>
</header>

<script>
  // 明るい/暗いの切り替え（手動の選択は localStorage.theme に残す。無ければ OS に従う）
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const themeBtn = document.getElementById('theme-switch');

  const isDark = (): boolean => {
    const t = root.getAttribute('data-theme');
    return t ? t === 'dark' : media.matches;
  };
  const syncTheme = (): void => {
    if (!themeBtn) return;
    const dark = isDark();
    themeBtn.setAttribute('aria-pressed', String(dark));
    themeBtn.setAttribute('aria-label', dark ? '明るい画面にする' : '暗い画面にする');
  };
  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // 保存できない環境（プライベートウィンドウ等）では、このページの間だけ切り替える
    }
    syncTheme();
  });
  media.addEventListener('change', syncTheme);
  syncTheme();
</script>
