---
// フッター — 作業台の地の上に、小さく。地の上の小さなリンクは teal-ink（specs/plug-2026.spec.md）。
const currentYear = new Date().getFullYear();
const links = [
  { href: 'https://github.com/nigoh', label: 'GitHub' },
  { href: 'https://zenn.dev/hironobunigo', label: 'Zenn' },
];
---

<footer class="mx-auto max-w-[1200px] px-4 pb-10 pt-12 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-3 border-t border-ui-line pt-6 text-sm text-ui-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono">&copy; {currentYear} H.NIGO</p>
    <p class="flex flex-wrap items-center gap-x-5 gap-y-1">
      {
        links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center text-ui-teal-ink underline-offset-4 hover:underline">
            {l.label}
          </a>
        ))
      }
      <span>
        デザイン：
        <a href="https://github.com/nigoh/pipe-in" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center text-ui-teal-ink underline-offset-4 hover:underline">
          pipe-in の「プラグ」
        </a>
      </span>
    </p>
  </div>
</footer>
