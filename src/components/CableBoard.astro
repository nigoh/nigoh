---
// C 差すと見えるケーブル（specs/physics-2026.spec.md・specs/shell-2026.spec.md 05）。
// 左の仕事の札（中に小さな帯＝いつの仕事か。右の縁にコンセント）と、右の「出力」のモニター。
// モニターから出たケーブルの先のプラグをどれかの仕事に差すと、モニターにその仕事が出る。
// 札はボタンでもある（押すとプラグが飛んで差さる）。
// JS 無しでは札を隠し、全部の仕事を縦に並べる（経歴の一覧）。
import Icon from './Icon.astro';
import type { BoardJob } from './board';

interface Props {
  jobs: BoardJob[];
  /** 帯の目盛りに出す年（左端・中・右端） */
  axis: number[];
}

const { jobs, axis } = Astro.props;
---

<div class="board" data-board>
  <div class="board-jobs">
    {/* 帯の目盛り（左端・真ん中・右端の年）。飾り — 期間はモニターに文字で出る */}
    <p class="job-axis font-mono text-sm text-ui-muted" aria-hidden="true">
      {axis.map((y) => <span>{y}</span>)}
    </p>
    <ol class="m-0 flex list-none flex-col gap-1.5 p-0" aria-label="見たい仕事を選ぶ">
      {
        jobs.map((job, i) => (
          <li>
            <button
              type="button"
              class="job-btn"
              data-job={i}
              data-period={job.period}
              data-label={job.short}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls="board-monitor"
            >
              <span class="font-bold leading-snug">{job.short}</span>
              <span class="job-track" aria-hidden="true">
                <i class:list={[{ 'is-now': job.ongoing }]} style={`left: ${job.bar.left}%; width: ${job.bar.width}%;`} />
              </span>
              <span class="plug-sock" aria-hidden="true">
                <i />
                <i />
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="board-monitor" id="board-monitor">
    <span class="board-anchor" aria-hidden="true"></span>
    <p class="monitor-head font-mono text-sm">出力：<span data-monitor-title>{jobs[0]?.period}</span></p>
    <ol class="m-0 list-none space-y-8 p-0">
      {
        jobs.map((job, i) => (
          <li class:list={['job-detail', { 'is-on': i === 0 }]} data-detail={i}>
            <p class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-sm text-ui-muted">{job.period}</span>
              {job.ongoing ? (
                <span class="chip chip-teal">
                  <Icon name="refresh-cw" size={15} />
                  進行中
                </span>
              ) : (
                <span class="chip chip-ok">
                  <Icon name="circle-check" size={15} />
                  一区切り
                </span>
              )}
            </p>
            <h3 class="mt-1 text-xl font-bold leading-snug">{job.industry}</h3>
            <p class="mt-1 text-ui-muted">{job.phase}</p>
            <ul class="mt-3 flex flex-wrap gap-2" aria-label="使った技術">
              {job.techs.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
    <p class="job-empty text-ui-muted" data-empty hidden>
      <Icon name="plug" class="mr-1 inline-block align-[-3px]" />
      プラグを差すと、その仕事が見られます。
    </p>
  </div>

  <p class="sr-only" aria-live="polite" data-board-status></p>
  <canvas class="board-rope" aria-hidden="true"></canvas>
  <span class="plug-handle" data-plug-handle aria-hidden="true"></span>
</div>

<script>
  import { initCableBoard } from '../scripts/cableBoard';
  initCableBoard();
</script>
