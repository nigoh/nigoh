---
interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description = 'H.Nigo - 札幌在住ソフトウェアエンジニアの自己紹介サイト' } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://nigoh.github.io/nigoh/';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Hironobu Nigo" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://github.com/nigoh.png" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="H.Nigo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://github.com/nigoh.png" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {/* フォント読み込み — render-blocking @import を廃し preconnect + link に移設（trends-2026-refresh.spec F-5） */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Hironobu Nigo",
      "url": siteUrl,
      "jobTitle": "Software Engineer",
      "knowsAbout": [
        "Android", "Java", "C++", "C", "TypeScript", "Python",
        "Embedded Systems", "Linux", "AI-Powered Development"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "札幌市",
        "addressRegion": "北海道",
        "addressCountry": "JP"
      },
      "sameAs": [
        "https://github.com/nigoh",
        "https://zenn.dev/hironobunigo"
      ]
    })} />
  </head>
  <body class="min-h-screen bg-constructivist-cream text-constructivist-black font-body antialiased">
    {/* T6a スクロール進捗バー（純装飾 — scroll() タイムライン対応ブラウザのみ表示） */}
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />
  </body>
</html>
