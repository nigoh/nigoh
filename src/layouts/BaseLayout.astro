---
interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description = 'H.Nigo - 札幌在住ソフトウェアエンジニアの自己紹介サイト' } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://nigoh.github.io/nigoh/';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* 配色の初期化 — 描画前に <head> で決める（FOUC 防止）。
        手動の選択（localStorage.theme）があればそれを data-theme に入れる。無ければ何も入れず、
        CSS の prefers-color-scheme に任せる（JS 無しでも OS の設定どおりに出る）。
        動きを減らす設定でなければ js-anim を付け、プラグが差さる前の形から始める（specs/plug-2026.spec.md「動き」）。 */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') root.setAttribute('data-theme', stored);
        } catch (e) {}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('js-anim');
      })();
    </script>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#211f1d" />
    <meta name="description" content={description} />
    <meta name="author" content="Hironobu Nigo" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://github.com/nigoh.png" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="H.Nigo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://github.com/nigoh.png" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {/* フォント — pipe-in と同じ 2 書体（見出し・本文 Zen Kaku Gothic New / 数 JetBrains Mono） */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Hironobu Nigo",
      "url": siteUrl,
      "jobTitle": "Software Engineer",
      "knowsAbout": [
        "Android", "Java", "C++", "C", "TypeScript", "Python",
        "Embedded Systems", "Linux", "AI-Powered Development"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "札幌市",
        "addressRegion": "北海道",
        "addressCountry": "JP"
      },
      "sameAs": [
        "https://github.com/nigoh",
        "https://zenn.dev/hironobunigo"
      ]
    })} />
  </head>
  <body class="min-h-screen font-sans text-base antialiased">
    <slot />
  </body>
</html>
